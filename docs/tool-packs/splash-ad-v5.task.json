{
  "schema": 2,
  "id": "quietstart.splash-ad",
  "name": "跳过开屏广告",
  "version": 5,
  "when": {
    "trigger": "app-foreground",
    "windowMs": 12000
  },
  "defaults": {
    "limit": {
      "maxWidth": 0.6,
      "maxHeight": 0.18,
      "maxArea": 0.075
    }
  },
  "steps": [
    {
      "find": {
        "by": ["text", "image", "structure"],
        "match": [
          "跳过广告",
          "跳过",
          "skipad",
          "skip",
          "关闭广告",
          "关闭"
        ],
        "actions": ["跳过广告", "skipad", "关闭广告"],
        "glyph": "x×✕✖✗✘╳",
        "idHints": [
          ["skip", "跳过图标"],
          ["close", "关闭图标"],
          ["dismiss", "关闭图标"]
        ],
        "fold": [
          ["過", "过"],
          ["廣", "广"],
          ["關", "关"],
          ["閉", "闭"]
        ],
        "normalise": [
          { "pattern": "略过", "replace": "跳过" },
          { "pattern": "跳过(?:此|该|本条)广告", "replace": "跳过广告" },
          { "pattern": "关闭(?:此|该|本条)广告", "replace": "关闭广告" },
          { "pattern": "skip(?:this)?(?:advertisement|ads?)", "replace": "skipad" },
          { "pattern": "(?:close|dismiss)(?:this)?(?:advertisement|ads?)", "replace": "关闭广告" },
          { "pattern": "[,，]?(按钮|button)$", "replace": "" }
        ],
        "kinds": ["countdown-image", "splash-corner", "ocr-skip", "ad-corner-image", "ad-edge-control"],
        "label": "跳过图标",
        "semanticKind": "ocr-skip",
        "adLayerIdGroups": [
          ["splash", "ad"],
          ["splash", "ads"],
          ["splash", "advert"],
          ["splash", "advertisement"],
          ["ad", "content"]
        ],
        "containerIdGroups": [
          ["splash", "container"],
          ["splash", "view"],
          ["splash", "ad"],
          ["ad", "fl"]
        ],
        "buttonIdGroups": [
          ["splash"],
          ["spl", "ad"]
        ],
        "pagePath": ["splash", "advert"],
        "countdownWords": ["倒计时", "countdown", "count_down"]
      },
      "need": {
        "evidence": {
          "text": ["广告", "Ad", "Advertisement"],
          "id": ["ad", "ads", "advert", "advertisement", "splash", "advertising"],
          "cta": [
            "(?:上滑|滑动|点击)[^。]{0,8}(?:跳转|进入|打开)[^。]{0,6}第三方",
            "上滑[^。]{0,12}(?:跳转|查看|进入|了解)",
            "^(?:点击|点按|轻点|轻触|点此)(?:这里|此处|去|即可)?(?:前往|进入|打开)?(?:观看|收看|查看|阅读|了解|欣赏|看)(?:更多|全部|完整|精彩|详细|相关){1,2}(?:内容|视频|直播|节目|详情|全文|报道|专题|资讯|故事)[>›→》〉»➜➔]?$",
            "^(?:点击|点按|轻点|轻触|点此)(?:去|前往|进入)(?:观看|收看|查看|阅读|了解|看)(?:内容|视频|直播|节目|详情|全文|报道|专题|资讯|故事|文章)[>›→》〉»➜➔]?$",
            "^(?:立即|马上|前往)(?:观看|收看|查看|阅读|了解|欣赏|看)(?:更多|全部|完整|精彩|详细|相关){1,2}(?:内容|视频|直播|节目|详情|全文|报道|专题|资讯|故事)[>›→》〉»➜➔]?$"
          ],
          "jump": [
            "(?:跳转|前往|进入|打开|下载|安装)[^。]{0,8}(?:详情页?|第三方(?:应用|App|平台|服务)?|下载页|应用商店)",
            "(?:详情页?|第三方应用?)[^。]{0,8}(?:跳转|前往|进入|打开|下载|安装)",
            "^(?:查看|了解|获取)(?:详情|更多)$",
            "^(?:立即|马上|一键)(?:下载|打开|安装|领取|试玩|体验|查看|购买)$"
          ],
          "jumpId": [
            "jump[_\\-/.]?ad(?:s|vert)?\\b",
            "(?:jump|skip|detail|open)[_\\-/](?:ad|ads|advert)(?:[_\\-/]|$)"
          ],
          "shake": [
            "(?:摇一摇|摇晃|晃动|摇动|扭转|扭一扭)[^。]{0,8}(?:跳转|详情|第三方|打开|下载|进入|前往|安装|查看|了解)",
            "(?:跳转|详情|第三方)[^。]{0,8}(?:摇一摇|摇晃|晃动|摇动|扭转)"
          ]
        }
      },
      "deny": {
        "context": ["青少年"]
      },
      "targetLabel": "跳过",
      "markerEvidenceLabel": "广告",
      "anchorLabels": ["跳过", "skip"],
      "do": { "capability": "click" },
      "expect": { "result": "gone", "settleMs": 5000, "samples": 2 }
    }
  ]
}
